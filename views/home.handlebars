<h1 class="fw-bold mt-5">
  {{{__ "home_intro_title"}}}
</h1>
<p class="lead mt-5">
  {{{__ "home_intro_description"}}}
  {{{__ "home_intro_community"}}}
</p>
<div class="card mt-5">
  <div class="card-body">
    <div class="row">
      <div class="col-12 col-md-6">
        <p class="fw-bold lead">
          {{server_name}}
        </p>
      </div>
      <div class="col-12 col-md-6 text-md-end pb-4 pb-md-0">
        {{#if community_has_metadata}}
          {{#if community_year}}
            <span class="badge rounded-pill text-bg-secondary">{{{__ "home_community_year_label"}}} {{community_year}}</span>
          {{/if}}
        {{/if}}
        {{#if server_post_count}}
          <span class="badge rounded-pill text-bg-info">{{server_post_count}} {{{__ "home_intro_community_post_count_label_plural"}}}</span>
        {{/if}}
        {{#if server_user_count}}
          <span class="badge rounded-pill text-bg-success">{{server_user_count}} {{{__ "home_intro_community_user_count_label_plural"}}}</span>
        {{/if}}
      </div>
      <div class="col-12">
        <p class="lead">
          {{{server_description}}}
        </p>
        {{#if community_has_metadata}}
        {{#if community_membership_cost}}
        <p><strong>{{{__ "home_community_membership_label"}}}</strong> {{community_membership_cost}}</p>
        {{/if}}
        <ul class="d-flex flex-column gap-2 mt-3 mb-3">
          <li>
            <a class="fw-bold" href="{{server_url}}" rel="noreferrer" target="_blank">{{{__ "home_cta_sign_up"}}}</a>
          </li>
          {{#if community_blog_url}}
          <li>
            <a href="{{community_blog_url}}" rel="noreferrer" target="_blank">{{{__ "home_community_links_blog"}}}</a>
          </li>
          {{/if}}
          {{#if community_moderation_url}}
          <li>
            <a href="{{community_moderation_url}}" rel="noreferrer" target="_blank">{{{__ "home_community_links_moderation"}}}</a>
          </li>
          {{/if}}
          {{#if community_annual_reports}}
          <li>
            <select id="annual-reports">
              <option value="">{{{__ "home_community_links_annual_reports"}}}</option>
              {{#each community_annual_reports}}
              <option value="{{url}}">{{year}}</option>
              {{/each}}
            </select>
          </li>
          {{/if}}
        </ul>
        <!-- <a href="https://fedidb.com/welcome">{{{__ "home_cta_secondary"}}}</a> -->
        {{else}}
        <p class="mt-4">
          <a class="btn btn-primary mb-3"
            href="{{server_url}}">{{{__ "home_cta_sign_up"}}}</a>
          <a class="btn btn-outline-primary mb-3"
            href="https://fedidb.com/welcome">{{{__ "home_cta_secondary"}}}</a>
        </p>
        {{/if}}
      </div>
    </div>
  </div>
  {{#if community_team}}
  <div class="card-footer">
    <p class="small text-body-secondary mb-1">{{{__ "home_community_moderation_team_label"}}}</p>
    <div class="team-container reverse">
      {{#each community_team}}
      <img src="{{profile_image}}" alt="{{name}}">
      {{/each}}
    </div>
  </div>
  {{/if}}
</div>
<p class="lead mt-5">
  {{#if show_one_app}}
    {{{__ "home_intro_apps_single"}}}
  {{else}}
    {{{__ "home_intro_apps_multiple"}}}
  {{/if}}
</p>

<div class="row mt-5">
  {{#each apps}}
  <div class="col-12 col-sm-6 col-md-4 col-lg-3 pb-4">
    <div class="card h-100">
      <div class="card-body">
        <span class="badge rounded-pill text-bg-info float-end fs-7">{{t platform}}</span>
        <h5 class="card-title">{{t name}}</h5>
        <p class="card-text fs-5">
          {{t description}}
          </p>
      </div>
      <div class="card-footer border-0 pb-3">
        <a href="{{get_link_url}}"
          class="fs-6 btn btn-primary">{{t get_link_label}}</a>
      </div>
    </div>
  </div>
  {{/each}}
</div>
<p class="lead mt-5">
   {{{recommend}}}
</p>
<div id="starter-packs" class="row"></div>